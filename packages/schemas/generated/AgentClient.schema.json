{
  "$id": "https://jefahnierocks.local/host-capability-substrate/schemas/AgentClient.schema.json",
  "title": "AgentClient",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0",
      "description": "Entity schema version for a Ring 0 schema."
    },
    "agent_client_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable local entity identifier. It is not a secret value."
    },
    "product_family": {
      "type": "string",
      "enum": [
        "claude_code",
        "codex",
        "cursor",
        "copilot",
        "devin",
        "windsurf",
        "augment",
        "amp",
        "opencode",
        "warp",
        "vscode_native",
        "unknown"
      ],
      "description": "Agent product family from ADR 0037."
    },
    "surface": {
      "type": "string",
      "enum": [
        "codex_cli",
        "codex_app_sandboxed",
        "codex_ide_ext",
        "claude_code_cli",
        "claude_desktop",
        "claude_code_ide_ext",
        "zed_external_agent",
        "warp_terminal",
        "mcp_server",
        "setup_script",
        "app_integrated_terminal",
        "remote_cloud_agent",
        "unknown"
      ],
      "description": "Agent or host surface that owns this execution context."
    },
    "app_build": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._+-]+$",
      "description": "Opaque build or dependency-bundle version observed by the kernel."
    },
    "dep_bundle_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._+-]+$",
      "description": "Opaque build or dependency-bundle version observed by the kernel."
    },
    "permission_mode": {
      "type": "string",
      "enum": [
        "default",
        "yolo",
        "approve_all",
        "read_only",
        "unknown"
      ],
      "description": "Declared permission mode; producer-asserted and kernel-verifiable."
    },
    "containment_mechanism": {
      "type": "string",
      "enum": [
        "terminal_no_isolation_capable",
        "ide_host_isolation_capable",
        "app_managed_bundle_capable",
        "kernel_sandbox_capable",
        "container_capable",
        "vm_capable",
        "remote_cloud_managed_capable",
        "unknown"
      ],
      "description": "Capability-class containment mechanism the product can provide."
    },
    "agent_client_state": {
      "type": "string",
      "enum": [
        "active",
        "retired"
      ],
      "description": "Lifecycle state for an AgentClient record."
    },
    "kernel_observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    },
    "valid_until": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "RFC 3339 timestamp with an explicit UTC offset."
        },
        {
          "type": "null"
        }
      ]
    },
    "audit_chain_link_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 digest with algorithm prefix. It is not reversible secret material."
    },
    "evidence_refs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "description": "Reference to an Evidence record or fixture."
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable source name or artifact path."
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "RFC 3339 timestamp with an explicit UTC offset."
          },
          "valid_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "description": "RFC 3339 timestamp with an explicit UTC offset."
              },
              {
                "type": "null"
              }
            ]
          },
          "authority": {
            "type": "string",
            "enum": [
              "project-local",
              "workspace-local",
              "user-global",
              "system",
              "derived",
              "sandbox-observation",
              "host-observation",
              "vendor-doc",
              "installed-runtime",
              "human-observed",
              "self-asserted"
            ],
            "description": "Authority plane for a fact or observation. `self-asserted` is the lowest class — producer claims with no observation behind them — and cannot be promoted to any higher class per charter inv. 8 / inv. 18 chain-walk rejection."
          },
          "parser_version": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "enum": [
              "authoritative",
              "high",
              "best-effort",
              "stale",
              "unknown"
            ],
            "description": "Confidence assigned to an observation by the producer."
          }
        },
        "required": [
          "evidence_id",
          "source",
          "observed_at",
          "authority",
          "confidence"
        ],
        "additionalProperties": false,
        "description": "Lightweight reference or embedded provenance preview for an Evidence record. Not a substitute for the full Evidence entity."
      }
    }
  },
  "required": [
    "schema_version",
    "agent_client_id",
    "product_family",
    "surface",
    "app_build",
    "dep_bundle_version",
    "permission_mode",
    "containment_mechanism",
    "agent_client_state",
    "kernel_observed_at",
    "valid_until",
    "audit_chain_link_hash",
    "evidence_refs"
  ],
  "additionalProperties": false,
  "description": "Ring 0 AgentClient entity from ADR 0037 and ADR 0038 Phase 2.1.1."
}
