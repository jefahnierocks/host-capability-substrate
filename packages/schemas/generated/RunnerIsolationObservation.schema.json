{
  "$id": "https://jefahnierocks.local/host-capability-substrate/schemas/RunnerIsolationObservation.schema.json",
  "title": "RunnerIsolationObservation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
