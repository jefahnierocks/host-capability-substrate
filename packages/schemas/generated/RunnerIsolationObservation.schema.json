          "description": "ADR 0032 runner network egress posture."
        },
        "host_filesystem_access": {
          "type": "string",
          "enum": [
            "isolated",
            "shared_workspace",
            "shared_host"
          ],
          "description": "ADR 0032 runner host filesystem access posture."
        }
      },
      "required": [
        "job_environment_kind",
        "workspace_cleanup_kind",
        "docker_socket_exposure_kind",
        "network_egress_kind",
        "host_filesystem_access"
      ],
      "additionalProperties": false,
      "description": "ADR 0032 runner_isolation BoundaryObservation payload."
    },
    "expected_payload": {
      "type": "object",
      "properties": {
        "job_environment_kind": {
          "type": "string",
          "enum": [
            "host",
            "container",
            "disposable_vm"
          ],
          "description": "ADR 0032 runner job environment kind."
        },
        "workspace_cleanup_kind": {
          "type": "string",
          "enum": [
            "always_clean",
            "checkout_clean_only",
            "persistent"
          ],
          "description": "ADR 0032 runner workspace cleanup posture."
