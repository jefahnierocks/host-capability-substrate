      "required": [
        "job_environment_kind",
        "workspace_cleanup_kind",
        "docker_socket_exposure_kind",
        "network_egress_kind",
        "host_filesystem_access"
      ],
      "additionalProperties": false,
      "description": "ADR 0032 runner_isolation BoundaryObservation payload."
    }
  },
  "required": [
    "schema_version",
    "evidence_schema_version",
    "boundary_observation_id",
    "source",
    "observed_at",
    "valid_until",
    "authority",
    "confidence",
