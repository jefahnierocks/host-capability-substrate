        "docker_socket_exposure_kind": {
          "type": "string",
          "enum": [
            "none",
            "host_workflow_only",
            "all_workflows",
            "unknown"
          ],
          "description": "ADR 0032 runner Docker socket exposure kind."
        },
        "network_egress_kind": {
          "type": "string",
          "enum": [
            "internet_full",
            "internet_restricted",
            "vpn_only",
            "egress_blocked"
          ],
          "description": "ADR 0032 runner network egress posture."
        },
        "host_filesystem_access": {
          "type": "string",
          "enum": [
            "isolated",
            "shared_workspace",
            "shared_host"
          ],
          "description": "ADR 0032 runner host filesystem access posture."
        }
