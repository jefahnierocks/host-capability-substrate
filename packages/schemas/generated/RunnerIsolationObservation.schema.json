        "proven",
        "denied",
        "pending",
        "stale",
        "contradictory",
        "inapplicable",
        "unknown"
      ],
      "description": "Seven-state boundary vocabulary from ADR 0022. unknown is not false; missing or unobservable evidence is distinct from denied."
    },
    "discrepancy_class": {
      "type": "string",
      "enum": [
        "observed_matches_expected",
        "observed_differs_from_expected",
        "expected_unobservable",
        "observed_without_expected",
        "expected_without_observed",
        "unknown"
      ],
      "description": "Optional discrepancy summary between observed_payload and expected_payload. Initial set; ontology-registry workflow may extend it."
    },
    "evidence_refs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "description": "Reference to an Evidence record or fixture."
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable source name or artifact path."
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "RFC 3339 timestamp with an explicit UTC offset."
          },
          "valid_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "description": "RFC 3339 timestamp with an explicit UTC offset."
              },
              {
                "type": "null"
              }
            ]
          },
          "authority": {
            "type": "string",
            "enum": [
              "project-local",
              "workspace-local",
              "user-global",
              "system",
              "derived",
              "sandbox-observation",
              "host-observation",
              "vendor-doc",
              "installed-runtime",
              "human-observed",
              "self-asserted"
            ],
            "description": "Authority plane for a fact or observation. `self-asserted` is the lowest class — producer claims with no observation behind them — and cannot be promoted to any higher class per charter inv. 8 / inv. 18 chain-walk rejection."
          },
          "parser_version": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "enum": [
              "authoritative",
              "high",
              "best-effort",
              "stale",
              "unknown"
            ],
            "description": "Confidence assigned to an observation by the producer."
          }
        },
        "required": [
          "evidence_id",
          "source",
          "observed_at",
          "authority",
          "confidence"
        ],
        "additionalProperties": false,
        "description": "Lightweight reference or embedded provenance preview for an Evidence record. Not a substitute for the full Evidence entity."
      }
    },
    "boundary_dimension": {
      "type": "string",
      "const": "runner_isolation"
    },
    "observed_payload": {
      "type": "object",
      "properties": {
        "job_environment_kind": {
          "type": "string",
          "enum": [
            "host",
            "container",
            "disposable_vm"
          ],
          "description": "ADR 0032 runner job environment kind."
        },
        "workspace_cleanup_kind": {
          "type": "string",
          "enum": [
            "always_clean",
            "checkout_clean_only",
            "persistent"
          ],
          "description": "ADR 0032 runner workspace cleanup posture."
        },
        "docker_socket_exposure_kind": {
          "type": "string",
          "enum": [
            "none",
            "host_workflow_only",
            "all_workflows",
            "unknown"
          ],
          "description": "ADR 0032 runner Docker socket exposure kind."
        },
        "network_egress_kind": {
          "type": "string",
          "enum": [
            "internet_full",
            "internet_restricted",
            "vpn_only",
            "egress_blocked"
