              "relation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "subject_kind",
              "subject_id"
            ],
            "additionalProperties": false,
            "description": "Subject reference for a ToolProvenance Evidence subtype."
          }
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
