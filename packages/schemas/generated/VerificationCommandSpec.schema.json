{
  "$id": "https://jefahnierocks.local/host-capability-substrate/schemas/VerificationCommandSpec.schema.json",
  "title": "VerificationCommandSpec",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0",
      "description": "Entity schema version for a Ring 0 schema."
    },
    "verification_command_spec_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable local entity identifier. It is not a secret value."
    },
    "workspace_context_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable local entity identifier. It is not a secret value."
    },
    "command_shape": {
      "type": "object",
      "properties": {
        "operation_class": {
          "type": "string",
          "const": "workspace_verify"
        },
        "mutation_scope": {
          "type": "string",
          "const": "verify_workspace"
        },
        "argv": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "env_refs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "variable_name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "description": "Environment variable name only. The schema intentionally has no value field."
              },
              "env_capture_mode": {
                "type": "string",
                "enum": [
                  "name_only",
                  "existence_only"
                ],
                "description": "Secret-safe capture mode for environment-variable names referenced by a verify command."
              },
              "required": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "variable_name",
              "env_capture_mode",
              "required"
            ],
            "additionalProperties": false,
            "description": "Environment variable reference carried by name only, never by value."
          }
        }
      },
      "required": [
        "operation_class",
        "mutation_scope",
        "argv",
        "env_refs"
      ],
      "additionalProperties": false,
      "description": "Verification command OperationShape-like payload: typed argv, not a shell string."
    },
    "expected_exit_codes": {
      "type": "object",
      "properties": {
        "success_codes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "POSIX-style process exit code."
          }
        },
        "allowed_failure_codes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "POSIX-style process exit code."
          }
        }
      },
      "required": [
        "success_codes",
        "allowed_failure_codes"
      ],
      "additionalProperties": false,
      "description": "Exit-code classification for a verification command."
    },
    "output_evidence_kind": {
      "type": "string",
      "enum": [
        "verification_receipt",
        "diagnostic_report"
      ],
      "description": "Expected evidence family produced by a verification command run."
    },
    "verification_command_spec_state": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "retired"
      ],
      "description": "Lifecycle state for a VerificationCommandSpec record."
    },
    "author_session_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable local entity identifier. It is not a secret value."
    },
    "author_agent_client_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable local entity identifier. It is not a secret value."
    },
    "kernel_observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    },
    "valid_until": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "RFC 3339 timestamp with an explicit UTC offset."
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_refs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "description": "Reference to an Evidence record or fixture."
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable source name or artifact path."
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "RFC 3339 timestamp with an explicit UTC offset."
          },
          "valid_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "description": "RFC 3339 timestamp with an explicit UTC offset."
              },
              {
                "type": "null"
              }
            ]
          },
          "authority": {
            "type": "string",
            "enum": [
              "project-local",
              "workspace-local",
              "user-global",
              "system",
              "derived",
              "sandbox-observation",
              "host-observation",
              "vendor-doc",
              "installed-runtime",
              "human-observed",
              "self-asserted"
            ],
            "description": "Authority plane for a fact or observation. `self-asserted` is the lowest class — producer claims with no observation behind them — and cannot be promoted to any higher class per charter inv. 8 / inv. 18 chain-walk rejection."
          },
          "parser_version": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "enum": [
              "authoritative",
              "high",
              "best-effort",
              "stale",
              "unknown"
            ],
            "description": "Confidence assigned to an observation by the producer."
          }
        },
        "required": [
          "evidence_id",
          "source",
          "observed_at",
          "authority",
          "confidence"
        ],
        "additionalProperties": false,
        "description": "Lightweight reference or embedded provenance preview for an Evidence record. Not a substitute for the full Evidence entity."
      }
    }
  },
  "required": [
    "schema_version",
    "verification_command_spec_id",
    "workspace_context_id",
    "command_shape",
    "expected_exit_codes",
    "output_evidence_kind",
    "verification_command_spec_state",
    "author_session_id",
    "author_agent_client_id",
    "kernel_observed_at",
    "valid_until",
    "evidence_refs"
  ],
  "additionalProperties": false,
  "description": "Ring 0 VerificationCommandSpec entity from ADR 0036 and ADR 0038 Phase 2.1.2."
}
